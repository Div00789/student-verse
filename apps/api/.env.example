# -------------------------------------------------------------
# StudentVerse Backend (NestJS) Environment Variables
# -------------------------------------------------------------

# Server Port
PORT=4000

# CORS Allowed Origin
FRONTEND_URL=http://localhost:3000

# Supabase PostgreSQL Database URLs
# 1. DATABASE_URL: Transaction / Session Pooler (port 6543) for application runtime
DATABASE_URL="postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct PostgreSQL connection (port 5432) for running Prisma migrations
DIRECT_URL="postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres"

# JWT Token Secret for Server-Side Verification
JWT_SECRET=your-secure-production-jwt-secret-min-32-chars

# Supabase Auth & Storage Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
