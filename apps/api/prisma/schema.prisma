// StudentVerse Database Schema (PostgreSQL)
// Development Owner: Nitesh
// Production Schema with Live Classes, Cohorts, Rubric-based Evaluations & Intermediated Hiring

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  EMPLOYER
  ADMIN
  TRAINER
  VISITOR
  LEARNER
  EMPLOYER_OWNER
  EMPLOYER_RECRUITER
  INSTRUCTOR
  CAREER_ADVISOR
  CONTENT_MANAGER
  PLATFORM_ADMIN
  SUPER_ADMIN
}

enum EmployerVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum TalentVisibility {
  PRIVATE
  SEARCHABLE
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseFormat {
  LIVE_ONLINE
  COHORT_BASED
  HYBRID
  SELF_PACED
}

enum CoursePublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonContentType {
  LIVE_SESSION
  RECORDED_VIDEO
  READING
  QUIZ
  PRACTICAL_PROJECT
  VIDEO
  PROJECT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}

enum BatchStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssignmentSubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  EVALUATED
  RESUBMISSION_REQUESTED
}

enum HiringRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  STUDENT_CONTACTED
  STUDENT_INTERESTED
  INTERVIEW_COORDINATION
  INTERVIEW_SCHEDULED
  OFFER_EXTENDED
  HIRED
  CLOSED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum WorkplaceType {
  REMOTE
  HYBRID
  ON_SITE
}

enum JobStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
  SUSPENDED
}

enum ApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum CredentialStatus {
  ISSUED
  REVOKED
}

// -------------------------------------------------------------
// 1. IDENTITY & ORGANISATIONS
// -------------------------------------------------------------

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String?
  fullName        String?
  country         String?
  timezone        String           @default("UTC")
  isEmailVerified Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  roles                   UserRoleAssignment[]
  sessions                Session[]
  learnerProfile          LearnerProfile?
  orgMemberships          OrganisationMember[]
  enrollments             Enrollment[]
  orders                  Order[]
  applications            Application[]
  certificates            Certificate[]
  auditEvents             AuditEvent[]

  // Live classes, batches & attendance
  taughtBatches           Batch[]                  @relation("TrainerBatches")
  batchEnrollments        BatchStudent[]
  taughtClasses           LiveClass[]              @relation("TrainerClasses")
  attendanceRecords       Attendance[]

  // Assignments & evaluations
  createdAssignments      Assignment[]             @relation("TrainerAssignments")
  assignmentSubmissions   AssignmentSubmission[]
  evaluationsGiven        AssignmentEvaluation[]   @relation("EvaluatorEvaluations")
  quizAttempts            QuizAttempt[]

  // Skills & ratings
  studentSkills           StudentSkill[]

  // Intermediated hiring requests
  candidateHiringRequests HiringRequest[]          @relation("CandidateHiringRequests")
  assignedHiringRequests  HiringRequest[]          @relation("AdminHiringRequests")

  @@index([email])
}

model UserRoleAssignment {
  id        String   @id @default(uuid())
  userId    String
  role      Role
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organisation {
  id                 String                     @id @default(uuid())
  name               String
  slug               String                     @unique
  website            String
  country            String
  verificationStatus EmployerVerificationStatus @default(UNVERIFIED)
  rejectionReason    String?
  verifiedAt         DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  members            OrganisationMember[]
  verificationLogs   EmployerVerificationLog[]
  jobPosts           JobPost[]
  shortlists         Shortlist[]
  hiringRequests     HiringRequest[]

  @@index([verificationStatus])
}

model OrganisationMember {
  id             String       @id @default(uuid())
  organisationId String
  userId         String
  role           Role         @default(EMPLOYER_RECRUITER)
  createdAt      DateTime     @default(now())

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
}

model EmployerVerificationLog {
  id             String                     @id @default(uuid())
  organisationId String
  status         EmployerVerificationStatus
  notes          String?
  adminUserId    String?
  createdAt      DateTime                   @default(now())

  organisation   Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// 2. EDUCATION, LIVE TRAINING & BATCHES
// -------------------------------------------------------------

model Course {
  id               String              @id @default(uuid())
  slug             String              @unique
  title            String
  subtitle         String?
  category         String
  level            CourseLevel         @default(BEGINNER)
  format           CourseFormat        @default(LIVE_ONLINE)
  status           CoursePublishStatus @default(DRAFT)
  durationHours    Int                 @default(30)
  totalSessions    Int                 @default(12)
  priceMinorUnits  Int                 @default(0)
  currency         String              @default("INR")
  description      String
  prerequisites    String[]
  learningOutcomes String[]
  thumbnailUrl     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  modules          CourseModule[]
  batches          Batch[]
  enrollments      Enrollment[]
  certificates     Certificate[]
  recordedLectures RecordedLecture[]
  assignments      Assignment[]

  @@index([slug])
  @@index([category])
  @@index([status])
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  orderIndex  Int      @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons          Lesson[]
  recordedLectures RecordedLecture[]

  @@index([courseId, orderIndex])
}

model Lesson {
  id              String            @id @default(uuid())
  moduleId        String
  title           String
  orderIndex      Int               @default(0)
  contentType     LessonContentType @default(LIVE_SESSION)
  contentBody     String?
  notes           String?
  videoUrl        String?
  durationMinutes Int               @default(60)
  isFreePreview   Boolean           @default(false)
  aiToolsUsed     String[]          @default([])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  module          CourseModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress        LessonProgress[]
  resources       LessonResource[]
  quizzes         Quiz[]

  @@index([moduleId, orderIndex])
}

model LessonResource {
  id           String   @id @default(uuid())
  lessonId     String
  title        String
  url          String
  resourceType String   @default("PDF") // PDF, TEMPLATE, CODE, LINK
  createdAt    DateTime @default(now())

  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model Quiz {
  id               String         @id @default(uuid())
  lessonId         String?
  courseId         String?
  title            String
  description      String?
  passingScorePct  Float          @default(70.0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  lesson           Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  questions        QuizQuestion[]
  attempts         QuizAttempt[]

  @@index([lessonId])
}

model QuizQuestion {
  id                 String   @id @default(uuid())
  quizId             String
  question           String
  options            String[]
  correctOptionIndex Int      @default(0)
  explanation        String?

  quiz               Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAttempt {
  id          String   @id @default(uuid())
  quizId      String
  userId      String
  scorePct    Float
  isPassed    Boolean  @default(false)
  answersJson Json?
  attemptedAt DateTime @default(now())

  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
}

model Batch {
  id                  String      @id @default(uuid())
  courseId            String
  trainerId           String?
  batchCode           String      @unique
  title               String
  startDate           DateTime
  endDate             DateTime
  scheduleTimezone    String      @default("UTC")
  scheduleDescription String
  maxSeats            Int         @default(30)
  status              BatchStatus @default(UPCOMING)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  course              Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trainer             User?             @relation("TrainerBatches", fields: [trainerId], references: [id], onDelete: SetNull)
  students            BatchStudent[]
  liveClasses         LiveClass[]
  recordedLectures    RecordedLecture[]

  @@index([courseId])
  @@index([status])
}

model BatchStudent {
  id         String   @id @default(uuid())
  batchId    String
  userId     String
  enrolledAt DateTime @default(now())

  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([batchId, userId])
}

model LiveClass {
  id             String    @id @default(uuid())
  batchId        String
  trainerId      String?
  title          String
  description    String?
  scheduledStart DateTime
  scheduledEnd   DateTime
  timezone       String    @default("UTC")
  meetingLink    String?
  isCompleted    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  batch          Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trainer        User?        @relation("TrainerClasses", fields: [trainerId], references: [id], onDelete: SetNull)
  attendance     Attendance[]

  @@index([batchId])
  @@index([scheduledStart])
}

model Attendance {
  id          String           @id @default(uuid())
  liveClassId String
  userId      String
  status      AttendanceStatus @default(PRESENT)
  notes       String?
  markedAt    DateTime         @default(now())

  liveClass   LiveClass        @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveClassId, userId])
}

model RecordedLecture {
  id              String   @id @default(uuid())
  courseId        String
  moduleId        String?
  batchId         String?
  title           String
  description     String?
  videoUrl        String
  durationMinutes Int      @default(60)
  thumbnailUrl    String?
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course          Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module          CourseModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  batch           Batch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([courseId])
}

model Enrollment {
  id             String           @id @default(uuid())
  userId         String
  courseId       String
  orderId        String?
  progressPct    Float            @default(0.0)
  isCompleted    Boolean          @default(false)
  completedAt    DateTime?
  enrolledAt     DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonProgress LessonProgress[]

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id                  String     @id @default(uuid())
  enrollmentId        String
  lessonId            String
  status              String     @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  isCompleted         Boolean    @default(false)
  score               Float?
  watchedSeconds      Float      @default(0.0)
  watchedPct          Float      @default(0.0)
  lastPositionSeconds Float      @default(0.0)
  completionMethod    String?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@index([lessonId])
}

// -------------------------------------------------------------
// 3. ASSIGNMENTS, PRACTICAL TASKS & WEIGHTED RUBRICS
// -------------------------------------------------------------

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  category    String
  description String?
  createdAt   DateTime @default(now())

  assignments  Assignment[]
  studentSkills StudentSkill[]

  @@index([category])
}

model StudentSkill {
  id                 String               @id @default(uuid())
  userId             String
  skillId            String
  ratingScore        Float                @default(0.0)
  confidenceLevel    String               @default("LOW") // LOW, MODERATE, HIGH
  verifiedTasksCount Int                  @default(0)
  lastAssessedAt     DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill              Skill                @relation(fields: [skillId], references: [id], onDelete: Cascade)
  history            SkillRatingHistory[]

  @@unique([userId, skillId])
  @@index([userId])
}

model SkillRatingHistory {
  id             String       @id @default(uuid())
  studentSkillId String
  previousScore  Float
  newScore       Float
  evaluationId   String?
  notes          String?
  createdAt      DateTime     @default(now())

  studentSkill   StudentSkill @relation(fields: [studentSkillId], references: [id], onDelete: Cascade)
}

model Assignment {
  id            String   @id @default(uuid())
  courseId      String
  skillId       String?
  trainerId     String?
  title         String
  slug          String   @unique
  description   String
  instructions  String
  deliverables  String[]
  difficulty    String   @default("INTERMEDIATE")
  maxScore      Int      @default(100)
  dueDate       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course        Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill         Skill?                  @relation(fields: [skillId], references: [id], onDelete: SetNull)
  trainer       User?                   @relation("TrainerAssignments", fields: [trainerId], references: [id], onDelete: SetNull)
  submissions   AssignmentSubmission[]

  @@index([courseId])
  @@index([skillId])
}

model AssignmentSubmission {
  id            String                     @id @default(uuid())
  assignmentId  String
  userId        String
  status        AssignmentSubmissionStatus @default(SUBMITTED)
  responseText  String?
  attachmentUrl String?
  projectUrl    String?
  submittedAt   DateTime                   @default(now())
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  assignment    Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluation    AssignmentEvaluation?

  @@unique([assignmentId, userId])
  @@index([assignmentId])
  @@index([userId])
}

model AssignmentEvaluation {
  id                    String   @id @default(uuid())
  submissionId          String   @unique
  evaluatorId           String
  accuracyScore         Float    // 40%
  executionScore        Float    // 30%
  problemSolvingScore   Float    // 20%
  submissionQualityScore Float   // 10%
  totalScore            Float    // 0-100 weighted
  feedbackNotes         String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  submission            AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  evaluator             User                 @relation("EvaluatorEvaluations", fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@index([evaluatorId])
}

// -------------------------------------------------------------
// 4. CREDENTIALS & CERTIFICATES
// -------------------------------------------------------------

model Certificate {
  id            String           @id @default(uuid())
  publicCode    String           @unique
  userId        String
  courseId      String
  status        CredentialStatus @default(ISSUED)
  issuer        String           @default("StudentVerse")
  issuedAt      DateTime         @default(now())
  revokedAt     DateTime?
  revokedReason String?

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([publicCode])
  @@index([userId])
}

// -------------------------------------------------------------
// 5. TALENT & CAREER PROFILES (OPT-IN PRIVACY FIRST)
// -------------------------------------------------------------

model LearnerProfile {
  id               String                 @id @default(uuid())
  userId           String                 @unique
  headline         String?
  bio              String?
  visibility       TalentVisibility       @default(PRIVATE)
  country          String?
  city             String?
  remotePreference Boolean                @default(true)
  resumeUrl        String?
  skills           String[]
  portfolioLinks   String[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentRecords   VisibilityConsentLog[]
  shortlistedBy    Shortlist[]

  @@index([visibility])
}

model VisibilityConsentLog {
  id               String           @id @default(uuid())
  learnerProfileId String
  previousStatus   TalentVisibility
  newStatus        TalentVisibility
  consentVersion   String           @default("v1.0")
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime         @default(now())

  learnerProfile   LearnerProfile   @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)

  @@index([learnerProfileId])
}

// -------------------------------------------------------------
// 6. RECRUITMENT, INTERMEDIATED HIRING & PARTNERS
// -------------------------------------------------------------

model JobPost {
  id                 String        @id @default(uuid())
  organisationId     String
  title              String
  slug               String        @unique
  description        String
  jobType            JobType       @default(FULL_TIME)
  workplaceType      WorkplaceType @default(REMOTE)
  status             JobStatus     @default(DRAFT)
  country            String?
  salaryMin          Int?
  salaryMax          Int?
  currency           String        @default("INR")
  requiredSkills     String[]
  screeningQuestions String[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organisation       Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  applications       Application[]
  shortlists         Shortlist[]

  @@index([organisationId])
  @@index([status])
  @@index([slug])
}

model Application {
  id             String            @id @default(uuid())
  jobId          String
  userId         String
  status         ApplicationStatus @default(NEW)
  coverNote      String?
  resumeSnapshot String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  job            JobPost           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         ApplicationEvent[]

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
}

model ApplicationEvent {
  id            String            @id @default(uuid())
  applicationId String
  previousStage ApplicationStatus
  newStage      ApplicationStatus
  notes         String?
  actorUserId   String?
  createdAt     DateTime          @default(now())

  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Shortlist {
  id               String         @id @default(uuid())
  organisationId   String
  learnerProfileId String
  jobPostId        String?
  notes            String?
  createdAt        DateTime       @default(now())

  organisation     Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  learnerProfile   LearnerProfile @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  jobPost          JobPost?       @relation(fields: [jobPostId], references: [id], onDelete: SetNull)

  @@unique([organisationId, learnerProfileId, jobPostId])
}

model HiringRequest {
  id               String                      @id @default(uuid())
  candidateId      String
  organisationId   String
  assignedAdminId  String?
  contactPerson    String
  businessEmail    String
  jobTitle         String
  jobDescription   String
  requiredSkills   String[]
  workplaceType    WorkplaceType               @default(REMOTE)
  salaryRange      String?
  additionalNotes  String?
  status           HiringRequestStatus         @default(SUBMITTED)
  internalNotes    String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  candidate        User                        @relation("CandidateHiringRequests", fields: [candidateId], references: [id], onDelete: Cascade)
  organisation     Organisation                @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  assignedAdmin    User?                       @relation("AdminHiringRequests", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  statusHistory    HiringRequestStatusHistory[]

  @@index([candidateId])
  @@index([organisationId])
  @@index([status])
}

model HiringRequestStatusHistory {
  id              String              @id @default(uuid())
  hiringRequestId String
  previousStatus  HiringRequestStatus
  newStatus       HiringRequestStatus
  notes           String?
  actorUserId     String?
  createdAt       DateTime            @default(now())

  hiringRequest   HiringRequest       @relation(fields: [hiringRequestId], references: [id], onDelete: Cascade)

  @@index([hiringRequestId])
}

model PlacementPartner {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  logoUrl            String?
  industry           String
  website            String
  location           String
  description        String
  isVerified         Boolean  @default(true)
  activeHiringTracks String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([slug])
  @@index([isVerified])
}

// -------------------------------------------------------------
// 7. COMMERCE & PAYMENTS
// -------------------------------------------------------------

model Order {
  id               String        @id @default(uuid())
  userId           String
  courseId         String
  amountMinorUnits Int
  currency         String        @default("INR")
  status           PaymentStatus @default(PENDING)
  gatewayPaymentId String?       @unique
  idempotencyKey   String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -------------------------------------------------------------
// 8. AUDIT TRAILS & OPERATIONS
// -------------------------------------------------------------

model AuditEvent {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  payload   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([resource])
}
