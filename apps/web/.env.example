# -------------------------------------------------------------
# StudentVerse Frontend (Next.js) Environment Variables for Vercel
# -------------------------------------------------------------

# Platform Branding
NEXT_PUBLIC_BRAND_NAME="StudentVerse"

# Backend REST API URL
# In local development: http://localhost:4000/api/v1
# In Vercel production: https://<your-backend-api-domain>/api/v1
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key"
