# -------------------------------------------------------------
# StudentVerse Frontend (Next.js) Environment Variables for Vercel
# -------------------------------------------------------------

# Platform Branding
NEXT_PUBLIC_BRAND_NAME="StudentVerse"

# API URL
# Leave empty or set to /api/v1 for Next.js standalone App Router route handlers
NEXT_PUBLIC_API_URL="/api/v1"

# Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# Supabase Server-side Service Role (Required on Vercel for Route Handlers)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# JWT Secret
JWT_SECRET="your-jwt-secret-key"
